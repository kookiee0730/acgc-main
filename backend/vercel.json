{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "uploads/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/auth/system-settings/cron-backup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/auth/system-settings/cron-site-inspection-reminders",
      "schedule": "* * * * *"
    }
  ]
}
