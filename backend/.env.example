MONGO_URI=mongodb://127.0.0.1:27017/reactvite
# Optional DNS override for environments whose resolver refuses MongoDB SRV queries.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=supersecretkey
# Use the value from Cloudinary's API environment variable field, or set the three variables below instead.
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CRON_SECRET=replace_with_a_long_random_secret
# Keep all recovery values in the backend environment or a secret manager only.
# ADMIN_RECOVERY_USERNAME=the-owner-username-you-configure
# ADMIN_RECOVERY_SECRET=<random secret, at least 32 characters>
# node scripts/generate-admin-recovery-secrets.js acgcsuperadmin
ADMIN_RECOVERY_TOTP_SECRET=<base32 secret, at least 20 decoded bytes>

PORT=5000
# Send a separate payment reminder when installation is within this many days (0-30).
PAYMENT_INSTALLATION_REMINDER_DAYS=3
# Use a real address on your authenticated sending domain. Verify the domain with
# your mail provider and publish its SPF, DKIM, and DMARC records in DNS.
EMAIL_FROM="ACGC Services <your_verified_sender@yourdomain.com>"

# Preferred transactional mail provider.
# Preferred Nodemailer SMTP provider. Copy these from Brevo > SMTP & API > SMTP.
# Use a Brevo SMTP key, not the Brevo REST API key.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=ACGC Services
# BREVO_SENDER_EMAIL=your_verified_sender@yourdomain.com

# Optional SMTP fallback. Gmail requires an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
# SMTP_PASSWORD=your_gmail_app_password_here


